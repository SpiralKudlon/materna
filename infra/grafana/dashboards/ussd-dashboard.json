{
    "title": "USSD Session Analytics",
    "timezone": "browser",
    "schemaVersion": 38,
    "refresh": "1m",
    "panels": [
        {
            "title": "USSD Session Completions",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(rate(sms_bridge_ussd_session_completions_total[5m])) by (status)",
                    "legendFormat": "{{status}}"
                }
            ]
        },
        {
            "title": "Median Time-to-Complete (Log Symptom)",
            "type": "gauge",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.5, sum(rate(sms_bridge_ussd_session_duration_seconds_bucket[5m])) by (le))",
                    "legendFormat": "Median Duration (Seconds)"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "max": 120,
                    "color": {
                        "mode": "thresholds"
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "value": null,
                                "color": "green"
                            },
                            {
                                "value": 30,
                                "color": "yellow"
                            },
                            {
                                "value": 60,
                                "color": "red"
                            }
                        ]
                    }
                }
            }
        }
    ]
}